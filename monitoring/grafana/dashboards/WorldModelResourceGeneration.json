            {
                "allowCustomValue": false,
                "current": {},
                "datasource": {
                    "type": "grafana-postgresql-datasource",
                    "uid": "${DS_GRAFANA-POSTGRESQL-DATASOURCE}"
                },
                "definition": "WITH RECURSIVE construct_hierarchy AS (\n    -- Base case: Start with constructs that have markets\n    SELECT \n        c.id, \n        c.name, \n        c.base_id,\n        c.id as root_id,\n        c.name as root_name\n    FROM construct c\n    INNER JOIN element e ON e.construct_id = c.id\n    INNER JOIN market m ON m.element_id = e.id\n    \n    UNION ALL\n    \n    -- Recursive case: Traverse up the hierarchy\n    SELECT \n        parent.id,\n        parent.name,\n        parent.base_id,\n        ch.root_id,\n        ch.root_name\n    FROM construct parent\n    INNER JOIN construct_hierarchy ch ON parent.id = ch.base_id\n)\nSELECT DISTINCT \n    c.id as __value,\n    c.name as __text\nFROM construct_hierarchy ch\nINNER JOIN construct c ON c.id = ch.id\nWHERE c.base_id IS NULL\nAND c.id IN (${planet_selector})\nORDER BY c.name;",
                "label": "Planet",
                "name": "planet",
                "options": [],
                "query": "WITH RECURSIVE construct_hierarchy AS (\n    -- Base case: Start with constructs that have markets\n    SELECT \n        c.id, \n        c.name, \n        c.base_id,\n        c.id as root_id,\n        c.name as root_name\n    FROM construct c\n    INNER JOIN element e ON e.construct_id = c.id\n    INNER JOIN market m ON m.element_id = e.id\n    \n    UNION ALL\n    \n    -- Recursive case: Traverse up the hierarchy\n    SELECT \n        parent.id,\n        parent.name,\n        parent.base_id,\n        ch.root_id,\n        ch.root_name\n    FROM construct parent\n    INNER JOIN construct_hierarchy ch ON parent.id = ch.base_id\n)\nSELECT DISTINCT \n    c.id as __value,\n    c.name as __text\nFROM construct_hierarchy ch\nINNER JOIN construct c ON c.id = ch.id\nWHERE c.base_id IS NULL\nAND c.id IN (${planet_selector})\nORDER BY c.name;",
                "refresh": 1,
                "regex": "",
                "type": "query"
            },
            {
                "allowCustomValue": false,
                "current": {},
                "datasource": {
                    "type": "grafana-postgresql-datasource",
                    "uid": "${DS_GRAFANA-POSTGRESQL-DATASOURCE}"
                },
                "definition": "SELECT DISTINCT \n    id.id as __value,\n    id.name as __text\nFROM item_definition id\nWHERE id.id IN (\n    -- Items that are used as ingredients\n    SELECT DISTINCT ri.item_id \n    FROM recipe_ingredient ri\n)\nAND id.id NOT IN (\n    -- Items that are produced by recipes\n    SELECT DISTINCT rp.item_id \n    FROM recipe_product rp\n)\nORDER BY id.name;",
                "label": "Resources",
                "multi": true,
                "name": "resource",
                "options": [],
                "query": "SELECT DISTINCT \n    id.id as __value,\n    id.name as __text\nFROM item_definition id\nWHERE id.id IN (\n    -- Items that are used as ingredients\n    SELECT DISTINCT ri.item_id \n    FROM recipe_ingredient ri\n)\nAND id.id NOT IN (\n    -- Items that are produced by recipes\n    SELECT DISTINCT rp.item_id \n    FROM recipe_product rp\n)\nORDER BY id.name;",
                "refresh": 1,
                "regex": "",
                "type": "query"
            },
            {
                "allowCustomValue": false,
                "current": {},
                "datasource": {
                    "type": "grafana-postgresql-datasource",
                    "uid": "${DS_GRAFANA-POSTGRESQL-DATASOURCE}"
                },
                "definition": "WITH RECURSIVE construct_hierarchy AS (\n    SELECT \n        c.id, \n        c.name, \n        c.base_id,\n        c.id as market_construct_id\n    FROM construct c\n    INNER JOIN element e ON e.construct_id = c.id\n    INNER JOIN market m ON m.element_id = e.id\n    \n    UNION ALL\n    \n    SELECT \n        parent.id,\n        parent.name,\n        parent.base_id,\n        ch.market_construct_id\n    FROM construct parent\n    INNER JOIN construct_hierarchy ch ON parent.id = ch.base_id\n)\nSELECT DISTINCT \n    m.id as __value,\n    m.name as __text\nFROM construct_hierarchy ch\nINNER JOIN construct planet ON planet.id = ch.id AND planet.base_id IS NULL\nINNER JOIN construct_hierarchy mch ON mch.market_construct_id = ch.market_construct_id\nINNER JOIN element e ON e.construct_id = mch.market_construct_id\nINNER JOIN market m ON m.element_id = e.id\nWHERE planet.id IN (${planet})\nORDER BY m.name;",
                "label": "Market",
                "multi": true,
                "name": "market",
                "options": [],
                "query": "WITH RECURSIVE construct_hierarchy AS (\n    SELECT \n        c.id, \n        c.name, \n        c.base_id,\n        c.id as market_construct_id\n    FROM construct c\n    INNER JOIN element e ON e.construct_id = c.id\n    INNER JOIN market m ON m.element_id = e.id\n    \n    UNION ALL\n    \n    SELECT \n        parent.id,\n        parent.name,\n        parent.base_id,\n        ch.market_construct_id\n    FROM construct parent\n    INNER JOIN construct_hierarchy ch ON parent.id = ch.base_id\n)\nSELECT DISTINCT \n    m.id as __value,\n    m.name as __text\nFROM construct_hierarchy ch\nINNER JOIN construct planet ON planet.id = ch.id AND planet.base_id IS NULL\nINNER JOIN construct_hierarchy mch ON mch.market_construct_id = ch.market_construct_id\nINNER JOIN element e ON e.construct_id = mch.market_construct_id\nINNER JOIN market m ON m.element_id = e.id\nWHERE planet.id IN (${planet})\nORDER BY m.name;",
                "refresh": 1,
                "regex": "",
                "type": "query"
            },
