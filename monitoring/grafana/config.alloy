
local.file_match "marketbot_logs" {
    path_targets = [
        {
            __path__ = "/var/log/marketbot/**/*.json",
            service_name = "marketbot",
        },
    ]

    sync_period = "5s"
}

loki.source.file "marketbot_logs" {
  targets = local.file_match.marketbot_logs.targets
  tail_from_end = false
  forward_to = [loki.process.marketbot_router.receiver]
}

loki.process "marketbot_router" {

  // Group multi-line, pretty-printed JSON into a single log entry
  stage.multiline {
    firstline     = "^\\s*\\{"
    max_wait_time = "2s"
    max_lines     = 1000
  }

  // Extract fields from the JSON payload
  stage.json {
    expressions = {
      level        = "level",
      logger       = "logger",
      appkind      = "appkind",
      timestamp_ns = "timestamp_ns",
      message      = "message",
    }
  }

  // Use the original high-precision timestamp from the log entry
  stage.timestamp {
    source = "timestamp_ns"
    format = "UnixNs"
  }

  // Minimal labels; keep the full JSON as the log line for query-time parsing
  stage.labels {
    values = {
      service_name = "marketbot",
      level        = "",
      logger       = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

// Loki write configuration - sends logs to your Loki instance
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ============================================================================
// METRICS HANDLING SIMPLIFIED
// ============================================================================
// MarketBot metrics are now scraped directly by DU Prometheus server
// This eliminates the need for Alloy to handle metrics via remote_write
// Much simpler and more reliable architecture!
